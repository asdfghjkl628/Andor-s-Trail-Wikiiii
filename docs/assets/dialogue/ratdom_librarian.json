{"root":"ratdom_librarian","nodes":{"ratdom_librarian":{"m":null,"r":[["N","ratdom_librarian_42",[["questProgress","ratdom_nondisplay",95,0]]],["N","ratdom_librarian_2",[]]],"w":[]},"ratdom_librarian_10":{"m":"Yes. I see it now. Please leave. My master is not present today.","r":[["Andor - master? What ... Where is my brother?","ratdom_librarian_12",[]]],"w":[]},"ratdom_librarian_12":{"m":"That does not concern you. Mind your own business and leave now!","r":[["Bye.","X",[]],["Tell me about Andor, or ...","ratdom_librarian_14",[]]],"w":[]},"ratdom_librarian_14":{"m":"Or what? Attack? Hahaha!","r":[["You'll soon stop laughing.","F",[]],["Just you wait when I come back.","X",[]]],"w":[]},"ratdom_librarian_2":{"m":"Andor! Good that you are back at last!","r":[["I am $playername. You have confused me with my brother.","ratdom_librarian_10",[]],["Indeed. Any news?","ratdom_librarian_20",[]],["Here I have a new book for your library.","ratdom_librarian_40",[["inventoryRemove","book_world_history",1,0]]]],"w":[]},"ratdom_librarian_20":{"m":"I am not sure. Today I hear footsteps of strangers in the corridors.","r":[["[muttering] Probably mine.","ratdom_librarian_22",[]],["Then what are you waiting for? Go and look who is wandering through our passages!","ratdom_librarian_30",[]],["Nonsense. Strangers would never find this secret library.","ratdom_librarian_24",[]]],"w":[]},"ratdom_librarian_22":{"m":"What? You are the stranger! You are not allowed to be here!","r":[["It's fine, I'm going already.","X",[]],["Andor is my brother. I'm going to look for a clue to his whereabouts now. You won't stop me from doing that.","F",[]]],"w":[]},"ratdom_librarian_24":{"m":"You're right, I'm sure I only see pipe dreams.","r":[["N","ratdom_librarian_26",[["inventoryKeep","book_world_history",1,0]]]],"w":[]},"ratdom_librarian_26":{"m":"If only I had something to read. Something new, that I haven't read twenty times already.","r":[["Here I have a new book for your library.","ratdom_librarian