{"root":"inspiring_snake_master_10","nodes":{"inspiring_snake_master_10":{"m":"Hello, young adventurer. I am Ewmondold, a world famous traveler.","r":[["N","inspiring_snake_master_select",[]]],"w":[]},"inspiring_snake_master_20":{"m":"Thanks for killing the Snake master, sucker - the way for me to rule is now free...","r":[],"w":[["removeSpawnArea","inspiring_snake_master",null,"wild2"],["questProgress","new_snake_master",10,null],["spawnAll","cavesnake_master_ewmondold",null,"snakecave3"]]},"inspiring_snake_master_25":{"m":"Have you found my map yet?","r":[["No, not yet.","X",[]]],"w":[]},"inspiring_snake_master_30":{"m":"Are you looking to help a man in need?","r":[["Not right now.  Bye.","X",[]],["Yes, of course I am.  What can I do for you?","inspiring_snake_master_40",[]]],"w":[]},"inspiring_snake_master_40":{"m":"I too am an adventurer.  I recently attempted to make my way through this here cave.","r":[["N","inspiring_snake_master_50",[]]],"w":[]},"inspiring_snake_master_50":{"m":"In the beginning it was relatively easy.  It wasn't until I ran into the Snake master's minions.","r":[["N","inspiring_snake_master_60",[]]],"w":[]},"inspiring_snake_master_60":{"m":"I was quickly ambushed and was forced to flee in order to save my life. But of course, during my attempt to flee, I dropped my map.","r":[["I could retrieve the map for you.","inspiring_snake_master_70",[]]],"w":[]},"inspiring_snake_master_70":{"m":"Please do and hurry back to me.","r":[],"w":[["questProgress","new_snake_master",5,null]]},"inspiring_snake_master_80":{"m":"Ah, my 'map'. Good!","r":[["N","inspiring_snake_master_20",[]]],"w":[["questProgress","new_snake_master",20,null]]},"inspiring_snake_master_select":{"m":null,"r":[["N","inspiring_snake_master_30",[["killedMonster","snake_master",1,1],["questProgress","new_snake_master",5,1]]],["N","inspiring_snake_master_25",[["questProgress","new_snake_master",5,0],["killedMonster","snake_master",1,1]]],["N","inspiring_snake_master_20",[["killedMonster