dom","","40",0]]],["","blackjack_win_24",[["random","","66",0]]],["","blackjack_win_25",[]]],"w":[]},"blackjack_lose_15":{"m":"I have 15 points. Bad luck for you.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_lose_16":{"m":"[You show each other your cards]. I have 16 points and you lose. Next time you will be lucky.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_lose_17":{"m":"[You show each other your cards.] I have 17 points so you lose. Don't give up.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_lose_18":{"m":"[You show each other your cards.] I have 18 points and you lose. Next game next chance for you.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_lose_19":{"m":"[You show each other your cards.] I have 19 points and you lose. Double your bet and win back what you lost.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_lose_20":{"m":"[You show each other your cards.] I have 20 points. Bad luck for you.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_lose_21":{"m":"[You show each other your cards.] I have 21 points and you lose. Next time, you will be lucky.","r":[["N","blackjack_dealer_40",[]]],"w":[]},"blackjack_play_higher_amounts":{"m":"Now let's stop this child's game and play for higher amounts.","r":[["N","blackjack_bet",[]]],"w":[["questProgress","brv_blackjack",45,null]]},"blackjack_rules":{"m":"We play with several 32-piece card decks from 7 to 10, jack (2 points), queen (3 points), king (4 points) and ace (11 points).\n\nYou can draw as many cards as you want and you will get them face down so only you can take a look at them. After each draw you can decide to draw another card or stop. You lose if you have drawn more than 21 points.\n\t\n\nAfter you stop I will draw following the same rules. Then we show each other our cards. You win if you have more points than I have; otherwise you lose.","r":[["N","blackjack_bet_select",[]]],"w":[]},"blackjack_win":{"m":null,"r":[["","blackjack_win_1gold",[["questProgress","brv_blackjack_hidden",1,0]]],["","blackjack_win_2gold",[["questProgress","brv_blackjack_hidden",10,0]]],["","blackjack_win_5gold",[["questProgress","brv_blackjack_hidden",20,0]]],["","blackjack_win_10gold",[["questProgress","brv_blackjack_hidden",30,0]]]],"w":[["alignmentChange","brv_blackjack_won",1,null]]},"blackjack_win_10gold":{"m":"You win 10 gold.","r":[["One more game.","blackjack_bet_select",[]]],"w":[["giveItem","gold",20,null]]},"blackjack_win_15":{"m":"I have 15 points. You have a lot of luck.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_16":{"m":"[You show each other your cards.] I have 16 points. In my opinion, you are a bit too lucky.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_17":{"m":"[You show each other your cards.] I have 17 points. You will take my last coin if you stay that lucky.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_18":{"m":"[You show each other your cards.] I have 18 points and you win. Give me a chance to win my money back.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_19":{"m":"[You show each other your cards.] I have 19 points. You have a lot of luck.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_1gold":{"m":"You win 1 gold.","r":[["I am lucky since I was a child.","blackjack_bet_select",[]]],"w":[["giveItem","gold",2,null]]},"blackjack_win_20":{"m":"[You show each other your cards.] I have 20 points. In my opinion you are a bit too lucky.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_22":{"m":"[You show each other your cards.] I have 22 points. You will take my last coin if you stay that lucky.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_23":{"m":"[You show each other your cards.] I have 23 points. Give me a chance to win my money back.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_24":{"m":"[You show each other your cards.] I have 24 points. You have a lot of luck.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_25":{"m":"[You show each other your cards.] I have 25 points. In my opinion you are a bit too lucky.","r":[["N","blackjack_win",[]]],"w":[]},"blackjack_win_2gold":{"m":"You win 2 gold.","r":[["One more game please.","blackjack_bet_select",[]]],"w":[["giveItem","gold",4,null]]},"blackjack_win_5gold":{"m":"You win 5 gold.","r":[["I am a good player.","blackjack_bet_select",[]]],"w":[["giveItem","gold",10,null]]}},"q":{"brv_blackjack":["Fair play?",1,{"10":"I heard noices from the back room but I was not allowed to enter because I didn't know the password.","20":"Zimsko told me about gambling in the back room and that he lost a lot of money. He thinks that they are cheating.","30":"I told Zimsko that I want to find out more about the gambling and he told me the password to access the back room.","31":"I have to win and lose a few times until they trust me and play for higher amounts. Then they start cheating.","40":"With the password, I was allowed to enter the back room.","45":"They trust me and now and are playing for higher amounts.","50":"After I accused the dealer of cheating, a tavern brawl started.","60":"All the people involved in the tavern brawl survived, but I am no longer allowed to enter the back room.","70":"I told Zimsko that I believe the gamblers are cheating.","80":"I told Zimsko that I believe the gamblers are not cheating."}],"brv_blackjack_hidden":["Brimhaven blackjack story flags",0,{"1":"Bet 1","10":"Bet 2","20":"Bet 5","30":"Bet 10","100":"Seat taken","110":"Started talking to Zimsko","120":"Bought Zimsko beer","130":"Zimsko talked about loosing money","140":"Played blackjack for higher amounts","150":"Allowed to enter backroom"}],"place_to_forge":["A place to forge",1,{"10":"Nocmar refused to forge heartsteel in his shop, fearing discovery by Geomyr's men. He revealed that he once owned a glowing white house south of Fallhaven, where a special forge still burns. That forge was the only place he ever worked heartsteel. But after falling into debt, he lost the house to Alkapoan. If Nocmar is to forge again, I must help him regain it.","20":"Nocmar told me that Alkapoan holds the deed and key to the glowing white house. He said the forge within never dies, always blazing, ready for work. If I can reclaim the deed and key from Alkapoan, Nocmar will finally have his forge back.","30":"Alkapoan scoffed when I mentioned Nocmar. He said the only way to reclaim the glowing white house is to pay him fifty thousand gold. Nothing else will satisfy him.","35":"I told Alkapoan I wanted the glowing white house for myself. He agreed to sell it for forty thousand gold, but only if I first complete a task for him to prove my worth.","40":"Alkapoan asked me to collect an overdue 'operation tax' of five thousand gold from a card dealer in the back room of Brimhaven's tavern. I'll need to go there and retrieve the gold for Alkapoan before he will sell me the deed to the white house for forty thousand.","45":"I was able to collect the overdue 'operation tax' from the dealer and now I should return to Alkapoan.","50":"After I paid Alkapoan, he gave me the deed and the key to the white house south of Fallhaven. I should bring them back to Nocmar.","60":"I was able to finally give Nocmar back what was rightfully his...possession of his forge house."}]},"i":{},"mo":{"brv_blackjack_dealer":"Dealer"},"f":{},"sk":{"weaponChance":"Weapon Accuracy","weaponDmg":"Hard Hit","barter":"Merchant","dodge":"Dodge","barkSkin":"Bark Skin","moreCriticals":"More Criticals","betterCriticals":"Better Criticals","speed":"Combat Speed","coinfinder":"Treasure Hunter","moreExp":"Quick Learner","cleave":"Cleave","eater":"Corpse Eater","fortitude":"Increased Fortitude","evasion":"Evasion","regeneration":"Regeneration","lowerExploss":"Failure Mastery","magicfinder":"Magic Finder","resistanceMental":"Strong Mind","resistancePhysical":"Enduring Body","resistanceBlood":"Pure Blood","shadowBless":"Dark blessing of the Shadow","crit1":"Internal bleeding","crit2":"Fracture","rejuvenation":"Rejuvenation","taunt":"Taunt","concussion":"Concussion","weaponProficiencyDagger":"Dagger proficiency","weaponProficiency1hsword":"One-handed sword proficiency","weaponProficiency2hsword":"Two-handed sword proficiency","weaponProficiencyAxe":"Axe proficiency","weaponProficiencyBlunt":"Blunt weapon proficiency","weaponProficiencyUnarmed":"Unarmed fighting","weaponProficiencyPole":"Pole weapon proficiency","armorProficiencyShield":"Shield proficiency","armorProficiencyUnarmored":"Unarmored fighting","armorProficiencyLight":"Light armor proficiency","armorProficiencyHeavy":"Heavy armor proficiency","fightstyleDualWield":"Fighting style: Dual wield","fightstyle2hand":"Fighting style: Two-handed weapon","fightstyleWeaponShield":"Fighting style: Weapon and shield","fightstyleUnarmedUnarmored":"Fighting style: Way of the monk","specializationDualWield":"Specialization: Dual wield","specialization2hand":"Specialization: Two-handed weapon","specializationWeaponShield":"Specialization: Weapon and shield","sporeImmunity":"Spore poison immunity"},"c":{},"tm":{}}